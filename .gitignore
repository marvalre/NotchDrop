# Compiled app bundle and archives — rebuilt from source via build.sh,
# and binaries don't belong in git. Ship them as GitHub Release assets.
NotchDrop.app/
NotchDrop *.app/
*.zip
*.dSYM/

# Local build backups
backups/

.DS_Store

# Local source snapshots (safety net for reverting)
snapshots/

# The auto-updater's Ed25519 private key (see scripts/keygen.swift). It must
# only ever live on the machine that signs releases — never in git, never on
# GitHub.
update_signing_key.private
